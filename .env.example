# Telegram Bot Token (obtain from @BotFather)
BOT_TOKEN=your_bot_token_here

# Telegram API credentials (obtain from https://my.telegram.org)
API_ID=your_api_id_here
API_HASH=your_api_hash_here

# Admin Telegram numeric user ID
ADMIN_ID=your_telegram_user_id_here

# Database URL (default: SQLite, can switch to PostgreSQL)
# SQLite:      sqlite+aiosqlite:///./data/bot.db
# PostgreSQL:  postgresql+asyncpg://user:pass@localhost:5432/dbname
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db

# Encryption key for session data (auto-generated if empty)
ENCRYPTION_KEY=
